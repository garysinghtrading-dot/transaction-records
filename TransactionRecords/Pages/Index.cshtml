@page
@model IndexModel

@{
    ViewData["Title"] = "Home page";
}


<div class="container mt-5" style="max-width: 400px;">
    <h2 class="text-center mb-4">Welcome Financial Records</h2>

    <!-- Error/Status Message Display -->
    @if(!string.IsNullOrEmpty(Model.LoginMessage))
    {
        <div class="alert alert-danger" role="alert">
            @Model.LoginMessage
        </div>
    }

    <!-- Login Card -->
    <div class="card p-4 shadow-sm">
        <h4 class="mb-3">Login</h4>

        <form method="post">
            <div class="form-group mb-3">
                <label>Username</label>
                <input asp-for="Username" class="form-control" placeholder="Enter username" required />
            </div>

            <div class="form-group mb-3">
                <label>Password</label>
                <input asp-for="Password" type="password" class="form-control" placeholder="Enter password" required />
            </div>

            <button type="submit" asp-page-handler="Login" class="btn btn-primary w-100">Log In</button>
        </form>
    </div>

    <!-- Sign Up Button -->
    <div class="text-center mt-4">
        <a class="btn btn-outline-secondary w-100" href="/Signup">Sign Up</a>
    </div>
</div>


