@page
@model TransactionRecords.Pages.Home.HomeModel

@{
    ViewData["Title"] = "Enter Record";
}

<div class="container mt-5" style="max-width: 400px;">
    <!-- Modern Bootstrap 5 alternative to .jumbotron -->
    <div class="p-4 bg-light rounded-3 text-center border shadow-sm">
        
        <!-- Clean single-line username display -->
        <h1 class="h3 mb-0">
            Welcome @(!string.IsNullOrEmpty(Model.UserName) ? Model.UserName : "User")
        </h1>

    </div>
</div>

<div class="container mt-5" style="max-width: 400px;">
    <h2 class="text-center mb-4">Welcome Enter a record</h2>

    <!-- Error/Status Message Display -->
    @if (!string.IsNullOrEmpty(Model.StatusMessage))
    {
        <div class="alert alert-danger" role="alert">
            @Model.StatusMessage
        </div>
    }

    <!-- Record Card -->
    <div class="card p-4 shadow-sm">
        <h4 class="mb-3">New Transaction</h4>

        <form method="post">
            <div class="form-group mb-3">
                <label>Amount</label>
                <input asp-for="Amount" class="form-control" placeholder="$1000" required />
            </div>

            <div class="form-group mb-3">
                <label>Transaction Type</label>
                <select asp-for="TransType" class="form-control" required>
                    <option value="" disabled selected>Select a transaction type</option>
                    <option value="withdrawal">Expense</option>
                    <option value="Deposit">Deposit</option>
                </select>
            </div>

            <button type="submit" asp-page-handler="EnterTransactionRecord" class="btn btn-primary w-100">Save Record</button>
        </form>
    </div>
</div>